{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@mikage/config": ["packages/config/src/index.ts"],
      "@mikage/domain": ["packages/domain/src/index.ts"],
      "@mikage/contracts": ["packages/contracts/src/index.ts"],
      "@mikage/runtime-cli-entry": ["packages/runtime-cli-entry/src/index.ts"],
      "@mikage/runtime-execution-port": ["packages/runtime-execution-port/src/index.ts"],
      "@mikage/runtime-orchestration-boundary": ["packages/runtime-orchestration-boundary/src/index.ts"],
      "@mikage/studio-application-facade": ["packages/studio-application-facade/src/index.ts"],
      "@mikage/persistence-read-port": ["packages/persistence-read-port/src/index.ts"],
      "@mikage/canon-validator": ["packages/canon-validator/src/index.ts"],
      "@mikage/benchmark-auditor": ["packages/benchmark-auditor/src/index.ts"],
      "@mikage/persistence-shell": ["packages/persistence-shell/src/index.ts"],
      "@mikage/studio-control-shell": ["packages/studio-control-shell/src/index.ts"],
      "@mikage/prompt-compiler": ["packages/prompt-compiler/src/index.ts"],
      "@mikage/production-assembler": ["packages/production-assembler/src/index.ts"],
      "@mikage/database": ["packages/database/src/index.ts"],
      "@mikage/queue": ["packages/queue/src/index.ts"],
      "@mikage/storage": ["packages/storage/src/index.ts"],
      "@mikage/logging": ["packages/logging/src/index.ts"],
      "@mikage/testing": ["packages/testing/src/index.ts"]
    }
  }
}
